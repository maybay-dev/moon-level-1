# WhisperPoll configuration — copy to .env and edit.
# NEVER commit .env or any real seed.

# ----------------------------------------------------------------------------
# Network selection for deploy/interact scripts: preview | preprod
# ----------------------------------------------------------------------------
WHISPERPOLL_NETWORK=preview

# ----------------------------------------------------------------------------
# Wallet seed (64 hex chars = 32 bytes). REQUIRED for deploy/interact.
# Generate one with:  openssl rand -hex 32
# The seed controls all funds for the deployer wallet — keep it secret.
# If unset, the deploy script generates an ephemeral seed and prints it ONCE.
# ----------------------------------------------------------------------------
DEPLOY_SEED=

# ----------------------------------------------------------------------------
# Proof server (docker compose -f deploy/compose.proof-server.yml up -d)
# ----------------------------------------------------------------------------
PROOF_SERVER_URL=http://127.0.0.1:6300

# ----------------------------------------------------------------------------
# Public Preview endpoints (defaults; override only if you run your own)
# ----------------------------------------------------------------------------
PREVIEW_INDEXER=https://indexer.preview.midnight.network/api/v4/graphql
PREVIEW_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
PREVIEW_NODE=https://rpc.preview.midnight.network

# ----------------------------------------------------------------------------
# Public Preprod endpoints
# ----------------------------------------------------------------------------
PREPROD_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
PREPROD_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
PREPROD_NODE=https://rpc.preprod.midnight.network

# ----------------------------------------------------------------------------
# Faucets (used automatically to fund a fresh deployer wallet)
# ----------------------------------------------------------------------------
PREVIEW_FAUCET=https://faucet.preview.midnight.network
PREPROD_FAUCET=https://faucet.preprod.midnight.network
